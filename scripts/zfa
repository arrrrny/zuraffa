#!/bin/bash
#
# The sanctioned dev-loop entry for the zfa CLI (the no-JIT policy).
#
# Nothing may spawn the zfa CLI in JIT mode: a `dart bin/zfa.dart …` child
# pays the VM front-end + full-package JIT compile before it runs a single
# command, and it silently runs whatever the source tree happens to be at
# that moment. This launcher keeps ONE compiled artifact under the shared
# cache (`.dart_tool/zfa_cli_bin/zfa_exe` — the same path
# `lib/src/cli/zfa_executable.dart` and `test/helpers/run_zfa_source.dart`
# use), rebuilds it only when the source is newer, and execs it.
#
#   scripts/zfa tdd run 090-my-feature --project /tmp/proj
#
# Rules of the loop:
#   - use `scripts/zfa …` (or the installed ~/.local/bin/zfa) — never
#     `dart bin/zfa.dart …`;
#   - `dart bin/zfa.dart` is reserved for `dart test` itself;
#   - `scripts/rebuild.sh` INSTALLS the system binary — it is not the loop.
#
# Copy-if-fresh tier: when the repo-local cache is missing or stale, the
# launcher first checks the system binary (~/.local/bin/zfa, then zfa on
# PATH — the first executable candidate that is fresh wins, so a stale local
# install never shadows a fresher PATH binary). A candidate is fresh when it
# is newer than every freshness input, and when a `zfa.build_commit` marker
# sits next to it (scripts/rebuild.sh writes one), the marker must match this
# checkout's HEAD — the #1664 commit proof, so a binary built from another
# tree cannot be adopted on mtimes alone. A fresh candidate is copied into
# the cache — turning a 5-minute compile into a 1-second copy while
# preserving the no-JIT guarantee (issue #1687).
#
# The rebuild is serialized (flock where available) and staged through a temp
# sibling + atomic rename, so a concurrent invocation can never exec a
# half-written binary (issue #644, Linux ETXTBSY). The copy tier stages under
# its own per-process name and renames the same way.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CACHE_DIR="$ROOT/.dart_tool/zfa_cli_bin"
EXE="$CACHE_DIR/zfa_exe"
TMP="$CACHE_DIR/zfa_exe.tmp"
LOCK_FILE="$CACHE_DIR/build.lock"

# True when every freshness input is older than the reference artifact —
# anything under bin/, anything under lib/src/, or the pubspec pair (the same
# freshness contract `ZfaExecutable` enforces at runtime, issue #1184). The
# copy tier runs this against a system-binary candidate; needs_build runs it
# against the cache artifact.
is_fresh_against_tree() {
  local reference="$1"
  for f in "$ROOT/pubspec.yaml" "$ROOT/pubspec.lock"; do
    if [ -f "$f" ] && [ "$f" -nt "$reference" ]; then
      return 1
    fi
  done
  if [ -n "$(find "$ROOT/bin" "$ROOT/lib/src" -type f -newer "$reference" -print -quit 2>/dev/null)" ]; then
    return 1
  fi
  return 0
}

# True when the cached artifact is missing or older than the CLI source.
needs_build() {
  [ ! -f "$EXE" ] && return 0
  if is_fresh_against_tree "$EXE"; then
    return 1
  fi
  return 0
}

# The #1664 commit proof, applied to the copy tier: when a `zfa.build_commit`
# marker sits next to the candidate (scripts/rebuild.sh writes one), the
# binary may only be adopted when the marker equals this checkout's HEAD — a
# binary built in a different worktree or clone is "newer" by mtime without
# containing this tree's code. A missing marker (pre-#1184 install) leaves
# the mtime contract in force; a present but disagreeing or unresolvable
# marker rejects the candidate.
candidate_is_commit_proven() {
  local bin="$1"
  local marker
  marker="$(dirname "$bin")/zfa.build_commit"
  [ -f "$marker" ] || return 0
  local head
  head="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || true)"
  [ -n "$head" ] || return 1
  [ "$head" = "$(tr -d '[:space:]' 2>/dev/null < "$marker" || true)" ]
}

# Try to copy a system binary into the cache if it is fresher than all
# source inputs.  Returns 0 on success (cache is now populated), 1 when no
# suitable system binary exists or it is stale.
#
# Candidates are scanned in order (~/.local/bin/zfa, then zfa on PATH) and
# the first executable, fresh one wins — a stale local install therefore
# never shadows a fresher PATH binary.
copy_if_fresh() {
  local sys_bin="" cand=""
  for cand in "$HOME/.local/bin/zfa" "$(command -v zfa 2>/dev/null || true)"; do
    if [ -z "$cand" ] || [ ! -x "$cand" ]; then
      continue
    fi
    if ! is_fresh_against_tree "$cand"; then
      continue
    fi
    if ! candidate_is_commit_proven "$cand"; then
      continue
    fi
    sys_bin="$cand"
    break
  done
  [ -z "$sys_bin" ] && return 1
  # Stage privately: a shared staging path collides with the compile path
  # (which serializes on the lock and renames the same file), so concurrent
  # cold launches — the exact scenario this tier exists for — could publish a
  # half-written artifact and break the atomic-rename guarantee (#644).
  local stage="$TMP.$$"
  mkdir -p "$CACHE_DIR"
  if ! cp -f "$sys_bin" "$stage"; then
    rm -f "$stage"
    return 1
  fi
  chmod +x "$stage" 2>/dev/null || true
  if ! mv -f "$stage" "$EXE"; then
    rm -f "$stage"
    return 1
  fi
  echo "zfa: copied fresh system binary ($sys_bin) into cache ($EXE)" >&2
  return 0
}

release_lock() {
  if [ -n "${LOCKED_FLOCK:-}" ]; then
    flock -u 9 || true
  elif [ -n "${LOCKED_MKDIR:-}" ]; then
    rmdir "$LOCK_FILE.lockdir" 2>/dev/null || true
  fi
}

# Serialize the build across concurrent invocations. macOS ships no flock(1),
# so fall back to an atomic mkdir mutex with a bounded wait — the atomic
# rename below is what actually keeps a partial binary from being exec'd, this
# only avoids duplicate compiles.
acquire_lock() {
  mkdir -p "$CACHE_DIR"
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_FILE"
    flock 9
    LOCKED_FLOCK=1
    return 0
  fi
  local waited=0
  while ! mkdir "$LOCK_FILE.lockdir" 2>/dev/null; do
    sleep 0.1
    waited=$((waited + 1))
    if [ "$waited" -gt 3000 ]; then
      echo "zfa: waiting on $LOCK_FILE.lockdir (another build may be stuck) — continuing" >&2
      break
    fi
  done
  LOCKED_MKDIR=1
}

if needs_build; then
  # Fast path: copy a fresh system binary instead of recompiling (issue #1687).
  if copy_if_fresh; then
    :
  elif [ "${ZFA_NO_REBUILD:-}" = "1" ]; then
    echo "zfa: ZFA_NO_REBUILD=1 but no fresh system binary available — run scripts/rebuild.sh first" >&2
    exit 1
  else
    if [ ! -f "$ROOT/.dart_tool/package_config.json" ]; then
      echo "zfa: $ROOT/.dart_tool/package_config.json is missing — run 'dart pub get --no-example' first" >&2
      exit 1
    fi
    acquire_lock
    trap release_lock EXIT
    # Re-check under the lock: another invocation may have just built it.
    if needs_build; then
      echo "🔨 compiling zfa (scripts/zfa → $EXE)" >&2
      rm -f "$TMP"
      dart compile exe "$ROOT/bin/zfa.dart" --output "$TMP" >&2
      mv -f "$TMP" "$EXE"
    fi
    release_lock
    trap - EXIT
  fi
fi

exec "$EXE" "$@"
