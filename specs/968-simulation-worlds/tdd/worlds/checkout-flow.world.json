  "description": "The spec 968 demo world (acceptance criterion 1): a retry-with-backoff checkout sync developed green inside a committed, CI-verifiable world. Touchpoints from the declared dependency table (FirebaseAuth composes the #832 certified adapter; RestSync is corpus-served); virtual time (seed 968); banded latency; failure storms: auth expiry mid-flow, network flap over push calls 1-2, partial write at push call 4.",
  "failureSchedule": {
    "storms": [
      {
        "description": "the session expires mid-flow \u2014 honest consumers surface it, never blind-retry it",
        "failure": {
          "code": "user-token-expired",
          "type": "auth"
        },
        "fromCall": 1,
        "kind": "auth-expiry",
        "method": "signIn",
        "name": "auth-expiry-mid-flow",
        "toCall": 1,
        "touchpoint": "FirebaseAuth"
      },
      {
        "description": "network flaps over the first two push calls \u2014 retry-with-backoff must survive",
        "failure": {
          "status": 503,
          "type": "http"
        },
        "fromCall": 1,
        "kind": "network-flap",
        "method": "push",
        "name": "network-flap-push",
        "toCall": 2,
        "touchpoint": "RestSync"
      },
      {
        "description": "a half-written push response \u2014 honest syncs detect and repair",
        "failure": {
          "type": "partial"
        },
        "fromCall": 4,
        "kind": "partial-write",
        "method": "push",
        "name": "partial-write-push",
        "toCall": 4,
        "touchpoint": "RestSync"
      }
    ]
  },
