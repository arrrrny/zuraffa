.DS_Store
.dart_tool/
# The slice fixture (spec 043) needs its resolved package config committed:
# the walker's PackageResolver reads it, and CI has no local .dart_tool for
# the fixture. All its rootUris are relative, so it works in any copy.
!test/fixtures/slice_test_project/.dart_tool/
!test/fixtures/slice_test_project/.dart_tool/package_config.json
.idea/
.packages
pubspec.lock
.pub/
# BUG-1188: a bare `apps/` rule is FORBIDDEN here — it excludes the parent
# directory itself, and git cannot re-include paths under an excluded parent,
# so it silently defeats the !apps/zikzak_demo/ negation below and makes the
# AGENTS.md-mandated apps/zikzak_demo/PROGRESS.md stop record uncommittable.
# Scratch apps are ignored by the /apps/* + !apps/zikzak_demo/ block instead.
build/
ios/.generated/
ios/Flutter/Generated.xcconfig
ios/Runner/GeneratedPluginRegistrant.*
.vscode/
example/coverage/
# Generated Flutter platform artifacts (example app)
example/**/Flutter/ephemeral/
example/android/local.properties
example/ios/Flutter/Generated.xcconfig
example/ios/Runner/GeneratedPluginRegistrant.*
example/macos/Flutter/ephemeral/
CUSTOM_DOMAIN_SETUP.md
DOCUSAURUS_SETUP.md*
.tmp_integration_*
.junie
.flutter-plugins-dependencies
.zuraffa/plans
.flutter-plugins-dependencies
.opencode
.claude
.memsearch
handoffs/
.zfa/
coverage/
*.log
.env*
codedb*
patches
contracts
/extensions/
.contracts
# Scratch apps stay ignored, but bug 501's mock ZikZak app is a committed
# deliverable (US3 validation, spec 011) — re-include just that subtree.
/apps/*
!apps/zikzak_demo/
pubspec_overrides.yaml
pubspec.lock
.worktrees/
# Benchmark baseline stores (test pollution; user projects keep their own)
benchmarks/

# Mutation test report (feature 041 — zfa tdd verify)
# Generated by `dart run mutation_test mutation-test.xml -f md -o ...`
# Not committed; the audit score is appended to specs/<feature>/tdd/verification.md
mutation-test-report/
.specify/extensions/.cache/

# Spec-kit plan artifacts legitimately live under specs/**/contracts/
# (e.g. specs/050-corpus-import/contracts/corpus-import.md — the
# report-line contract the tests pin). Re-include them; the bare
# `contracts` rule above targets generated contract build dirs, not
# spec documents.
!specs/**/contracts/

# Local dev note (2026-09-09): apps/*/examples pubspec.yaml files carry
# machine-local dependency_overrides (path deps to ../../ and sibling zorphy).
# They are tracked, so they CANNOT be gitignored; they are held out of commits
# via git update-index --skip-worktree (reversible with --no-skip-worktree).
# A bare apps/ ignore rule is forbidden — see the BUG-1188 comment above.

# TDD cycle-log pins TMPDIR to the clone-local .tmpdir/ — per-run scratch
# (test lists, timeout helpers) must never be committed.
.tmpdir/

# zread wiki pages published to the website are generated, not source:
# tools/sync-website-docs.sh copies them from .zread/wiki/ (the source of
# truth) into website/static/docs/ for both local preview and CI. Only the
# viewer (website/static/docs/index.html) is committed.
website/static/docs/*.md
website/static/docs/wiki.json
mutation-test-1693-report/

# The ROOT tdd/ directory is per-run scratch, not a source artifact. The TDD
# tooling OVERWRITES tdd/test-list.md and tdd/verification.md with the CURRENT
# work item's single report (verify_command: "overwrites any stale copy"), so
# every branch rewrites the whole file and tracking it conflicted on EVERY
# open PR. Those conflicts were resolved by keeping both sides, which is what
# left master carrying two concatenated reports (issue #1685's + spec 1693's,
# two titles, two `Verdict: PASS` blocks) inside one file. Durable
# per-work-item records live under specs/<feature>/tdd/ and
# .specify/bugs/<id>/tdd/; the root mirror is regenerated and stays local.
/tdd/
